# ==============================================================================
# MNDO BUILDER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local frontend development:
#   cp .env.example .env.local
#
# NOTE: Variables prefixed with VITE_ are embedded into the client-side bundle.
# NEVER put private or service-role keys in VITE_ variables!
# ==============================================================================

# --- Supabase (Public Client) ---
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# --- Primary Platform Domain ---
VITE_PLATFORM_DOMAIN=mndo.online
VITE_BUILDER_URL=https://builder.pages.dev

# --- Cloudflare Turnstile (Optional Anti-Spam / Bot Protection) ---
# If unset, local/in-app fallback honeypot protection is used.
VITE_TURNSTILE_SITE_KEY=

# ==============================================================================
# CLOUDFLARE WORKER ENVIRONMENT SECRETS (Do NOT prefix with VITE_)
# Set these in Cloudflare Dashboard -> Workers -> Settings -> Variables / Secrets
# or via: npx wrangler secret put <NAME>
# ==============================================================================
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-placeholder
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder (if privileged edge tasks are required)
# TURNSTILE_SECRET_KEY=your-turnstile-secret
# RESEND_API_KEY=re_your_resend_api_key (for optional email delivery)
# RESEND_FROM_EMAIL=notifications@mndo.online
